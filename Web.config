<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <system.webServer>

    <!-- Pagina iniziale: index.php (accesso). index.html non esiste più (fase 1 di _doc/arch-i18n-a11y.md) -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.php" />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- MIME types per file statici (modelli / decoder / modules) -->
    <staticContent>
      <!-- ES Modules -->
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="text/javascript" />

      <!-- JSON -->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />

      <!-- Draco decoder locali -->
      <remove fileExtension=".wasm" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />

      <remove fileExtension=".data" />
      <mimeMap fileExtension=".data" mimeType="application/octet-stream" />

      <!-- Modelli -->
      <remove fileExtension=".obj" />
      <mimeMap fileExtension=".obj" mimeType="text/plain" />

      <remove fileExtension=".mtl" />
      <mimeMap fileExtension=".mtl" mimeType="text/plain" />

      <!-- GLB / GLTF -->
      <remove fileExtension=".glb" />
      <mimeMap fileExtension=".glb" mimeType="model/gltf-binary" />

      <remove fileExtension=".gltf" />
      <mimeMap fileExtension=".gltf" mimeType="model/gltf+json" />

      <!-- Draco point cloud -->
      <remove fileExtension=".drc" />
      <mimeMap fileExtension=".drc" mimeType="model/vnd.drc" />

      <!-- SVG (usato da SVGLoader) -->
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />

      <!-- VRML (usato da VRMLLoader) -->
      <remove fileExtension=".wrl" />
      <mimeMap fileExtension=".wrl" mimeType="model/vrml" />
      <remove fileExtension=".vrml" />
      <mimeMap fileExtension=".vrml" mimeType="model/vrml" />
      <!-- VRML compresso (gzip): lo decomprime loadVRML nel browser, NON Content-Encoding -->
      <remove fileExtension=".wrz" />
      <mimeMap fileExtension=".wrz" mimeType="model/vrml" />

      <!-- Rhino 3DM -->
      <remove fileExtension=".3dm" />
      <mimeMap fileExtension=".3dm" mimeType="application/x-rhino" />

      <!-- IFC -->
      <remove fileExtension=".ifc" />
      <mimeMap fileExtension=".ifc" mimeType="application/octet-stream" />

      <!-- Audio / video (HySpace: musica di sottofondo, video dello Schermo).
           Espliciti per via di X-Content-Type-Options: nosniff più sotto. -->
      <!-- Caratteri locali (Titillium Web, lib/fonts) -->
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />

      <remove fileExtension=".mp3" />
      <mimeMap fileExtension=".mp3" mimeType="audio/mpeg" />
      <remove fileExtension=".mp4" />
      <mimeMap fileExtension=".mp4" mimeType="video/mp4" />
    </staticContent>

    <!-- Limiti richieste (utile anche con PHP) -->
    <security>
      <requestFiltering>
        <!-- 100 MB (2026-09-26: era 20 MB; i GLB convertiti dall'Archivio esercitazioni
             con le texture incluse possono superarli) -->
        <requestLimits maxAllowedContentLength="104857600" />
        <!-- Cartelle mai servite al browser (IIS risponde 404): credenziali (cfg, che ha
             anche il suo web.config), schema, documentazione, codice dismesso, sorgenti git.
             Stesse regole del .htaccess per Apache. -->
        <hiddenSegments>
          <add segment="cfg" />
          <add segment="sql" />
          <add segment="install" />
          <add segment="_doc" />
          <add segment="_dev" />
          <add segment="_cestino" />
          <add segment=".git" />
          <add segment=".claude" />
          <add segment=".vscode" />
        </hiddenSegments>
        <!-- File di backup/dump/documentazione: mai serviti -->
        <fileExtensions>
          <add fileExtension=".bak" allowed="false" />
          <add fileExtension=".old" allowed="false" />
          <add fileExtension=".orig" allowed="false" />
          <add fileExtension=".swp" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".md" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <!-- Performance: cache per statici 
    <caching enabled="true" enableKernelCache="true" />-->

    <!-- Compressione (se IIS l’ha abilitata) 
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />-->

    <!-- Headers utili (opzionali ma consigliati) -->
    <httpProtocol>
      <customHeaders>
        <!-- evita sniffing MIME -->
        <add name="X-Content-Type-Options" value="nosniff" />
        <!-- framing -->
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <!-- referrer policy -->
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <!-- permessi browser API non utilizzate -->
        <add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=()" />
        <!-- Content-Security-Policy in modalità REPORT-ONLY (2026-09-28, step 4 di
             _doc/arch-abilitazioni.md): NON blocca nulla, segnala soltanto le
             violazioni a api/csp_report.php (tabella csp_reports, scheda "CSP"
             della modale admin Abilitazioni). Quando le segnalazioni mostrano solo
             domini legittimi, si aggiungono quelli mancanti e si rinomina l'header
             in Content-Security-Policy. TENERE IDENTICA alla riga in .htaccess. -->
        <add name="Content-Security-Policy-Report-Only" value="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://maps.googleapis.com https://*.gstatic.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' data: https://cdn.jsdelivr.net https://fonts.gstatic.com; img-src 'self' data: blob: https://*.googleapis.com https://*.gstatic.com https://*.google.com https://*.ggpht.com https://upload.wikimedia.org; connect-src 'self' data: blob: https://cdn.jsdelivr.net https://*.googleapis.com https://*.gstatic.com https://*.google.com https://*.wikipedia.org https://*.open-meteo.com; media-src 'self' data: blob: https://ice1.somafm.com; worker-src 'self' blob:; frame-src 'self' https:; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; report-uri api/csp_report.php" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>

  <!-- Codice della piattaforma (moduli .mjs, script, CSS): "no-cache" = il browser tiene
       i file ma a ogni caricamento chiede al server se sono cambiati (risposta 304 se no).
       Senza questa regola il browser usava la cache "euristica" e continuava a eseguire
       versioni vecchie dei moduli anche dopo il caricamento dei nuovi (2026-09-26). -->
  <location path="app">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="ui">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="css">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <!-- lib/: librerie di terze parti tenute nel progetto e modificate (es. lib/litegraph,
       fork leggero 2026-10-04): stessa regola, una patch nuova deve arrivare subito. -->
  <location path="lib">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
