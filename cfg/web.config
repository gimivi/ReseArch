<?xml version="1.0" encoding="UTF-8"?>
<!-- Cartella di configurazione (credenziali DB/SMTP): mai servita via HTTP.
     Il segmento "cfg" è nascosto anche dal Web.config principale: qui remove+add
     evita l'errore "duplicate collection entry" e tiene la regola se questo file
     viene copiato senza il Web.config principale. -->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <remove segment="cfg" />
          <add segment="cfg" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
