<?xml version="1.0" encoding="UTF-8"?>
<!--
  =============================================================================
  RA_Data/web.config — protezione della cartella dei dati di ReseArch (IIS)
  =============================================================================
  Marcatore: ReseArch-RA_Data-sandbox
    ui/modal_uploads_tools.php accetta upload .html/.htm solo se trova questo
    marcatore in RA_Data/web.config o RA_Data/.htaccess.

  Copiare in <radice del sito>/RA_Data/web.config (accanto alla cartella GitHub).
  RA_Data sta ACCANTO alla cartella dell'app: il Web.config dell'app non vale qui.

  Perché: vedi RA_Data/.htaccess (stesso contenuto per Apache). In breve: un .html o
  un .svg aperto come documento gira in un'origine isolata ("sandbox") e non può
  usare la sessione né le API della piattaforma. Le letture dei moduli (fetch: TJS
  SVGLoader, HTM flow, TML, PDF.js…) e gli <img> non cambiano.

  L'intestazione solo per .svg/.html richiede il modulo IIS "URL Rewrite" (sezione
  <rewrite> qui sotto). Se dopo la copia RA_Data risponde con errore 500, il modulo
  manca: togliere la sezione <rewrite> e, in <customHeaders>, togliere il commento
  alla riga "Content-Security-Policy" (vale allora per tutti i file della cartella:
  innocua per immagini, modelli e dati; da verificare l'apertura diretta dei PDF).

  Dopo la copia, verificare: aprire un .svg di RA_Data nel browser → strumenti di
  sviluppo → Rete → intestazioni della risposta: deve esserci Content-Security-Policy.
  =============================================================================
-->
<configuration>
  <system.webServer>

    <staticContent>
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <!-- (2026-10-13) formati 3D e audio dei moduli (TJS, IFC, HYS): mancavano e IIS
           non li serviva (404.3). Stessi tipi del Web.config dell'app, che qui non vale. -->
      <remove fileExtension=".drc" />
      <mimeMap fileExtension=".drc" mimeType="model/vnd.drc" />
      <remove fileExtension=".glb" />
      <mimeMap fileExtension=".glb" mimeType="model/gltf-binary" />
      <remove fileExtension=".gltf" />
      <mimeMap fileExtension=".gltf" mimeType="model/gltf+json" />
      <remove fileExtension=".obj" />
      <mimeMap fileExtension=".obj" mimeType="text/plain" />
      <remove fileExtension=".mtl" />
      <mimeMap fileExtension=".mtl" mimeType="text/plain" />
      <remove fileExtension=".ply" />
      <mimeMap fileExtension=".ply" mimeType="application/octet-stream" />
      <remove fileExtension=".wrl" />
      <mimeMap fileExtension=".wrl" mimeType="model/vrml" />
      <remove fileExtension=".vrml" />
      <mimeMap fileExtension=".vrml" mimeType="model/vrml" />
      <remove fileExtension=".wrz" />
      <mimeMap fileExtension=".wrz" mimeType="model/vrml" />
      <remove fileExtension=".3dm" />
      <mimeMap fileExtension=".3dm" mimeType="application/x-rhino" />
      <remove fileExtension=".ifc" />
      <mimeMap fileExtension=".ifc" mimeType="application/octet-stream" />
      <remove fileExtension=".mp3" />
      <mimeMap fileExtension=".mp3" mimeType="audio/mpeg" />
      <!-- (2026-10-13) nuove estensioni dei Caricamenti (cfg/cfg_Upload.php): IIS non serve
           i file con estensione sconosciuta (errore 404.3). remove + add evita l'errore 500
           se il server ha già il tipo. -->
      <remove fileExtension=".mp4" />
      <mimeMap fileExtension=".mp4" mimeType="video/mp4" />
      <remove fileExtension=".webm" />
      <mimeMap fileExtension=".webm" mimeType="video/webm" />
      <remove fileExtension=".frag" />
      <mimeMap fileExtension=".frag" mimeType="application/octet-stream" />
      <remove fileExtension=".owl" />
      <mimeMap fileExtension=".owl" mimeType="application/rdf+xml" />
      <remove fileExtension=".rdf" />
      <mimeMap fileExtension=".rdf" mimeType="application/rdf+xml" />
      <remove fileExtension=".ttl" />
      <mimeMap fileExtension=".ttl" mimeType="text/turtle" />
      <remove fileExtension=".nt" />
      <mimeMap fileExtension=".nt" mimeType="application/n-triples" />
      <remove fileExtension=".n3" />
      <mimeMap fileExtension=".n3" mimeType="text/n3" />
      <remove fileExtension=".trig" />
      <mimeMap fileExtension=".trig" mimeType="application/trig" />
      <remove fileExtension=".jsonld" />
      <mimeMap fileExtension=".jsonld" mimeType="application/ld+json" />
      <!-- (2026-11-04) OLY: KML e GPX (XML) come octet-stream, così non si aprono mai come documento -->
      <remove fileExtension=".geojson" />
      <mimeMap fileExtension=".geojson" mimeType="application/geo+json" />
      <remove fileExtension=".kml" />
      <mimeMap fileExtension=".kml" mimeType="application/octet-stream" />
      <remove fileExtension=".gpx" />
      <mimeMap fileExtension=".gpx" mimeType="application/octet-stream" />
      <remove fileExtension=".tif" />
      <mimeMap fileExtension=".tif" mimeType="image/tiff" />
      <remove fileExtension=".tiff" />
      <mimeMap fileExtension=".tiff" mimeType="image/tiff" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>

    <!-- Nessuno script lato server nella cartella dei dati -->
    <security>
      <requestFiltering>
        <fileExtensions>
          <remove fileExtension=".php" />
          <add fileExtension=".php" allowed="false" />
          <remove fileExtension=".phtml" />
          <add fileExtension=".phtml" allowed="false" />
          <remove fileExtension=".asp" />
          <add fileExtension=".asp" allowed="false" />
          <remove fileExtension=".aspx" />
          <add fileExtension=".aspx" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <!-- Alternativa senza URL Rewrite (vedi sopra):
        <add name="Content-Security-Policy" value="sandbox allow-scripts allow-forms allow-popups allow-popups-to-escape-sandbox" />
        -->
      </customHeaders>
    </httpProtocol>

    <rewrite>
      <outboundRules>
        <rule name="RA_Data sandbox documenti">
          <match serverVariable="RESPONSE_Content_Security_Policy" pattern=".*" />
          <conditions>
            <add input="{URL}" pattern="\.(svgz?|html?|xhtml|xht|xml|owl|rdf)$" />
          </conditions>
          <action type="Rewrite" value="sandbox allow-scripts allow-forms allow-popups allow-popups-to-escape-sandbox" />
        </rule>
      </outboundRules>
    </rewrite>

  </system.webServer>
</configuration>
